# Den Heuvel Gebouwbeheer - Omgevingsvariabelen voorbeeld
# Kopieer dit bestand naar .env om live Google Apps Script relay in te schakelen.
# Laat APPS_SCRIPT_URL leeg om met de lokale persistente testadministratie (data/test_sheets.json) te werken.

# Lokale Gateway Poort
PORT=3000

# Webapp-URL van de gedeployde Apps Script (uit Google Apps Script -> Implementeren -> Webapp)
# Voorbeeld: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_URL=

# Gedeeld HMAC-SHA256 geheim voor server-naar-server ondertekening
# Dit geheim moet EXACT overeenkomen met de property 'RELAY_SECRET' in Apps Script Projectinstellingen.
RELAY_SECRET=denheuvel-test-secret-2026

# Google Drive Map ID voor afgeschermde testbijlagen (optioneel voor live Drive uploads)
DRIVE_TEST_FOLDER_ID=

